---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedWriting } from '../../writing';

export async function getStaticPaths() {
  const posts = await getPublishedWriting();
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-IE', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title={`${post.data.title} — Matteo Stara`} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{formatDate(post.data.date)}</p>
      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map(t => (
            <a href={`/writing/tag/${t}`} class="tag post-tag">#{t}</a>
          ))}
        </div>
      )}
      {post.data.tldr && (
        <section class="post-summary" aria-labelledby="post-summary-title">
          <h2 id="post-summary-title">TL;DR</h2>
          <p>{post.data.tldr}</p>
        </section>
      )}
    </header>
    {post.data.disclaimer && (
      <aside class="post-disclaimer" aria-labelledby="post-disclaimer-label">
        <p id="post-disclaimer-label" class="disclaimer-label">Disclaimer</p>
        <p>{post.data.disclaimer}</p>
      </aside>
    )}
    <div class="post-body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post-header {
    padding: clamp(1rem, 4vw, 1.75rem);
    background: color-mix(in srgb, var(--rp-iris) 10%, var(--rp-surface));
    border: 1px solid var(--rp-hl-med);
    border-top: 4px solid var(--rp-rose);
    border-radius: 6px;
    overflow-wrap: anywhere;
  }

  .post-title {
    color: var(--rp-iris-text);
  }

  .post-meta {
    color: var(--rp-subtle-text);
  }

  .post-summary {
    margin: 1.25rem 0 0;
    padding: 1rem;
    background: var(--rp-surface);
    border-radius: 4px;
  }

  .post-summary h2 {
    color: var(--rp-iris-text);
    margin-bottom: 0.5rem;
  }

  .post-summary p {
    color: var(--rp-text);
  }

  .post-disclaimer {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--rp-gold) 8%, var(--rp-surface));
    border: 1px solid color-mix(in srgb, var(--rp-gold) 35%, var(--rp-hl-med));
    border-inline-start: 4px solid var(--rp-gold);
    border-radius: 6px;
    color: var(--rp-text);
    font-size: 0.9rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .disclaimer-label {
    margin-bottom: 0.3rem;
    color: var(--rp-gold-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-body :global(a) {
    color: var(--rp-foam-text);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
    border-radius: 2px;
    overflow-wrap: anywhere;
  }

  .post-body :global(a:visited) {
    color: var(--rp-iris-text);
  }

  .post-body :global(a:hover),
  .post-body :global(a:focus-visible) {
    color: var(--rp-foam-text);
    background: color-mix(in srgb, var(--rp-foam) 12%, transparent);
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.12em;
  }
</style>
