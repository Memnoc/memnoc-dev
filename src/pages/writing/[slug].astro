---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedWriting } from '../../writing';
import CourseLabel from '../../components/CourseLabel.astro';
import CourseNavigation from '../../components/CourseNavigation.astro';
import SourceCode from '../../components/SourceCode.astro';
import BannerIcon from '../../components/BannerIcon.astro';

export async function getStaticPaths() {
  const posts = await getPublishedWriting();
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: {
      post,
      lessons: post.data.course ? posts
        .filter(candidate => candidate.data.course?.name === post.data.course!.name)
        .sort((a, b) => a.data.course!.lesson - b.data.course!.lesson) : [],
    },
  }));
}

const { post, lessons } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-IE', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title={`${post.data.title} - Matteo Stara`} description={post.data.description}>
  <article class="post">
    {post.data.course && (
      <CourseNavigation name={post.data.course.name} lessons={lessons} currentId={post.id} />
    )}
    {post.data.sourceCode && <SourceCode url={post.data.sourceCode} />}
    <header class="post-header">
      <CourseLabel course={post.data.course} />
      <h1 class="post-title">{post.data.title}</h1>
      {post.data.tldr && (
        <section class="post-summary" aria-label="TL;DR">
          <p>{post.data.tldr}</p>
        </section>
      )}
      <div class="post-details">
        <p class="post-meta">{formatDate(post.data.date)}</p>
        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map(t => (
              <a href={`/writing/tag/${t}`} class="tag post-tag">#{t}</a>
            ))}
          </div>
        )}
      </div>
    </header>
    <div class="post-body">
      <Content />
    </div>
    {post.data.disclaimer && (
      <aside class="post-disclaimer article-banner" aria-labelledby="post-disclaimer-label">
        <p id="post-disclaimer-label" class="article-banner-label"><BannerIcon kind="disclaimer" />Disclaimer</p>
        <p>{post.data.disclaimer}</p>
      </aside>
    )}
  </article>
</Base>

<style>
  .post-header {
    margin-bottom: 1.5rem;
    overflow-wrap: anywhere;
  }

  .post-title {
    color: var(--rp-iris-text);
  }

  .post-meta {
    color: var(--rp-subtle-text);
  }

  .post-summary {
    margin: 0.5rem 0 0.75rem;
    font-size: 0.975rem;
    line-height: 1.65;
  }

  .post-summary p {
    color: var(--rp-text);
    margin: 0;
  }

  .post-details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .post-tags {
    margin-top: 0;
  }

  .post-disclaimer {
    --banner-accent: var(--rp-gold);
    --banner-label: var(--rp-gold-text);
    margin: 2rem 0 0;
  }

  .post-body :global(a) {
    color: var(--rp-foam-text);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
    border-radius: 2px;
    overflow-wrap: anywhere;
  }

  .post-body :global(a:visited) {
    color: var(--rp-iris-text);
  }

  .post-body :global(a:hover),
  .post-body :global(a:focus-visible) {
    color: var(--rp-foam-text);
    background: color-mix(in srgb, var(--rp-foam) 12%, transparent);
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.12em;
  }
</style>
