---
import Base from '../layouts/Base.astro';
import AstViewer from '../components/AstViewer.tsx';
import ProjectMetadata from '../components/ProjectMetadata.astro';
import { builtEntries, currentWork, repositoryUrl, type BuiltStatus } from '../portfolio';

const builtStatusClass: Record<BuiltStatus, string> = {
  'Original': 'status-original',
  'Adapted and extended': 'status-adapted',
};
---

<Base title="Matteo Stara (memnoc)">
  <section class="profile-header" id="contact">
    <img src="/Matteo-profile-modified.png" alt="Matteo Stara" class="profile-img" />
    <div class="profile-info">
      <h1 class="name">Matteo Stara <span class="handle">(memnoc)</span></h1>
      <p class="title">Sr. Software Engineer</p>
      <div class="contact-row">
        <a href="mailto:memnochmod@gmail.com" class="contact-email">memnochmod@gmail.com</a>
        <div class="social-icons">
          <a href="https://github.com/Memnoc" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/matteo-genesio-stara-814062a7/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
            </svg>
          </a>
          <a href="https://labotteghina.gallery" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="La Botteghina">
            <svg width="15" height="15" viewBox="0 0 64 64" aria-hidden="true">
              <text x="32" y="50" font-family="Georgia, 'Times New Roman', serif" font-size="52" fill="currentColor" text-anchor="middle" font-style="italic">B</text>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="hero">
    <p class="oneliner">I write systems software in C and Rust and Typescript, compilers, distributed systems, and low-level tools.</p>
    <p class="oneliner">Professionally, I use AI to help build connectors between software systems.</p>
    <p class="oneliner">I also study applied AI systems, Computational Linguistics and Natural Language Processing, and I write about what I learn here.</p>
    <p class="current">Currently: committed to different projects, including a C course, an interpreter from Crafting Interpreters for my programming language StarScript, and a Rust course.</p>
  </section>

  <section class="demo-section" aria-label="Lox expression parser">
    <p class="section-caption">
      Standalone browser-side Lox expression parser inspired by the StarScript learning path.
    </p>
    <AstViewer client:only="react" />
  </section>

  <section class="built" aria-labelledby="built-heading">
    <h2 id="built-heading">Built</h2>
    <p class="portfolio-intro">
      Completed work whose public default branch carries source, a clean build, runnable proof,
      licensing, limitations, and provenance.
    </p>
    <div class="project-list">
      {builtEntries.map(entry => (
        <article class="project-card" aria-label={`${entry.name} — ${entry.status}`}>
          <div class="project-header">
            <a
              href={repositoryUrl(entry.repository)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${entry.name} source`}
            >{entry.name}</a>
            <span class={`status ${builtStatusClass[entry.status]}`}>{entry.status}</span>
          </div>
          {entry.repository === 'Memnoc/CodeAtlas' ? (
            <ProjectMetadata repository={entry.repository} />
          ) : <p class="blurb">{entry.blurb}</p>}
          <div class="lang-tags">
            {entry.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="current-work" aria-labelledby="current-work-heading">
    <h2 id="current-work-heading">Current work</h2>
    <p class="portfolio-intro">
      Work in progress, shown at its last publicly verified maturity and current availability.
    </p>
    <div class="project-list">
    <article class="project-card" aria-label="Drudwyn — Current work">
      <div class="project-header">
        <a href={repositoryUrl('Memnoc/tmux-drudwyn')} target="_blank" rel="noopener noreferrer" aria-label="View Drudwyn source">Drudwyn</a>
        <span class="status status-current">Current work</span>
      </div>
      <ProjectMetadata repository="Memnoc/tmux-drudwyn" />
    </article>
    <article class="project-card featured-current-work" aria-label={`${currentWork.name} — ${currentWork.status}`}>
      <div class="project-header">
        <span class="project-name">{currentWork.name}</span>
        <span class="status status-current">{currentWork.status}</span>
      </div>
      <p class="blurb">{currentWork.blurb}</p>
      <p class="availability">
        <a
          href={repositoryUrl(currentWork.repository)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${currentWork.name} source`}
        >View source</a>
      </p>
      <div class="lang-tags">
        {currentWork.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </article>
    </div>
  </section>

</Base>
