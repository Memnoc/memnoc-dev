---
import { bannerIconPaths } from '../lib/banner-icons.mjs';

interface Props {
  kind: keyof typeof bannerIconPaths;
}

const { kind } = Astro.props;
---

<svg class="banner-icon" width="16" height="16" viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.75"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={bannerIconPaths[kind]} />
</svg>
