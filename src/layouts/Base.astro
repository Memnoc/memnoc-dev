---
import '../styles/global.css';
import { SITE_IDENTITY, SITE_ORIGIN, SITE_STATE } from '../site';
import { getPublishedWriting } from '../writing';

declare const __GIT_HASH__: string;

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'Matteo Stara (memnoc)',
  description = 'Sr. Software Engineer using AI to help build connectors between software systems.',
  currentPath = Astro.url.pathname,
} = Astro.props;

const gitHash = __GIT_HASH__;
const hasPublishedWriting = (await getPublishedWriting()).length > 0;
const normalizedCurrentPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');
const canonicalPath = currentPath === '/' ? '/' : `${currentPath.replace(/\/$/, '')}/`;
const canonicalUrl = new URL(canonicalPath, SITE_ORIGIN).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {SITE_STATE === 'public-draft' && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_IDENTITY} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Apply theme before first paint to prevent flash -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('rp-theme');
        if (saved === 'rose-pine' || saved === 'moon' || saved === 'dawn') {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'moon');
        } else {
          document.documentElement.setAttribute('data-theme', 'dawn');
        }
      })();
    </script>
  </head>
  <body>
    <nav class="site-nav">
      <div class="nav-status">
        <span id="utc-clock" class="nav-clock" aria-label="Current UTC time"></span>
        <a
          href={`https://github.com/Memnoc/memnoc-dev/commit/${gitHash}`}
          target="_blank"
          rel="noopener noreferrer"
          class="build-hash"
        >build: {gitHash}</a>
      </div>
      <div class="nav-links">
        <a href="/" class:list={[{ active: normalizedCurrentPath === '/' }]} aria-current={normalizedCurrentPath === '/' ? 'page' : undefined}>home</a>
        <a href="/about" class:list={[{ active: normalizedCurrentPath === '/about' }]} aria-current={normalizedCurrentPath === '/about' ? 'page' : undefined}>about</a>
        {hasPublishedWriting && (
          <a href="/writing" class:list={[{ active: normalizedCurrentPath.startsWith('/writing') }]} aria-current={normalizedCurrentPath.startsWith('/writing') ? 'page' : undefined}>writing</a>
        )}
      </div>
      <select id="theme-select" aria-label="Theme">
        <option value="rose-pine">Rosé Pine</option>
        <option value="moon">Moon</option>
        <option value="dawn">Dawn</option>
      </select>
    </nav>
    <main>
      <slot />
    </main>

    <script>
      const themeSelect = document.querySelector<HTMLSelectElement>('#theme-select');

      if (themeSelect) {
        themeSelect.value = document.documentElement.getAttribute('data-theme') ?? 'dawn';
        themeSelect.addEventListener('change', () => {
          const theme = themeSelect.value;
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('rp-theme', theme);
        });
      }

      const clock = document.getElementById('utc-clock');
      function tick() {
        if (clock) clock.textContent = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
      }
      tick();
      setInterval(tick, 1000);
    </script>
  </body>
</html>
