{
  "name": "memnoc-dev",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test:evidence": "node --test tests/evidence/built-evidence.test.mjs",
    "test:projects": "node --test tests/projects/*.test.mjs",
    "test:projects:browser": "playwright test --config tests/projects/playwright.config.ts",
    "refresh:projects": "node scripts/refresh-projects.mjs",
    "test:browser": "playwright test",
    "test:accessibility": "playwright test accessibility.spec.ts assembled-quality.spec.ts",
    "verify:evidence": "node scripts/verify-built-evidence.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.3"
  }
}
